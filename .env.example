# PowerShell 환경변수로 직접 설정하거나 배포 플랫폼의 비밀 설정을 사용합니다.
# 앱은 .env를 자동으로 읽지 않습니다.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=username
ADMIN_PASSWORD=password
LOCAL_DEVELOPMENT=1
DATABASE=instance/experiment.sqlite
# 확정 정책: 개별 콘텐츠 카드의 실제 면적 50% 이상, 활성 탭에서 관측.
EXPOSURE_POLICY=cards
EXPERIMENT_START=
EXPERIMENT_END=
DISPLAY_TIMEZONE=Asia/Seoul
DATA_RELIABLE=1
DATA_QUALITY_REASON=
NOTICE_TEXT=
OPERATIONS_CONFIRMED=0
