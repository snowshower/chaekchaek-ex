# Set shell/platform environment variables; .env is not automatically loaded.
# Common secrets: never commit real values
SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Local SQLite: used when DATABASE_URL is empty
DATABASE=instance/experiment.sqlite
# Production PostgreSQL: provider URL including required TLS settings
DATABASE_URL=

LOCAL_DEVELOPMENT=1
EXPOSURE_POLICY=cards
EXPERIMENT_START=
EXPERIMENT_END=
DISPLAY_TIMEZONE=Asia/Seoul
DATA_RELIABLE=1
DATA_QUALITY_REASON=
NOTICE_TEXT=
OPERATIONS_CONFIRMED=0
# Optional dedicated integration test database (never production)
TEST_DATABASE_URL=
